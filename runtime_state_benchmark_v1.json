    "id": "R01",
    "family": "conflict_write",
    "runtime_rules": [
      "A write is eligible only for the configured key and if key/value/writer/version are all present.",
      "Higher version always wins.",
      "For equal version, higher writer_priority wins.",
      "Lower version never overrides canonical state."
